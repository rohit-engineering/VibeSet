rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow public read on marketplace digital products, allow write for catalog management
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // User accounts and profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders and purchase transactions
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
